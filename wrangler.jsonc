{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shutdown-calendar",
  "compatibility_date": "2025-08-03",
  "main": "./src/index.tsx",
  "routes": [
    {
      "pattern": "outages-calendar.aisaiev.net",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "shutdown_calendar",
      "database_name": "shutdown_calendar",
      "database_id": "fff597cb-93dd-4454-893f-f6407bbc8aef",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "triggers": {
    "crons": ["*/30 * * * *"],
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
  },
}
