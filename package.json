    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript-eslint": "^8.54.0",
    "vite": "^6.3.5",
    "vite-ssr-components": "^0.5.1",
    "wrangler": "^4.17.0"
