{
  "name": "shutdown-calendar",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "postinstall": "npm run cf-typegen",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply shutdown_calendar --local",
    "db:migrate:prod": "wrangler d1 migrations apply shutdown_calendar --remote",
    "db:studio": "drizzle-kit studio --config drizzle.config.local.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.10.5",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.2.3",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.18",
    "better-sqlite3": "^12.6.2",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript-eslint": "^8.54.0",
    "vite": "^6.3.5",
    "vite-ssr-components": "^0.5.1",
    "vitest": "^4.0.18",
    "wrangler": "^4.17.0"
  }
}
